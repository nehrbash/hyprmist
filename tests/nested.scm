#!/usr/bin/env guile
!#
(use-modules (ice-9 ftw) (ice-9 popen) (ice-9 textual-ports)
             (json) (srfi srfi-1) (srfi srfi-13))

(define args (cdr (command-line)))
(unless (>= (length args) 2)
  (error "usage: nested.scm HYPRLAND HYPRMIST.SO [COMPANION.SO ...]"))
(define compositor (canonicalize-path (car args)))
(define mist (canonicalize-path (cadr args)))
(define companions (map canonicalize-path (cddr args)))
(define parent-display
  (let ((display (or (getenv "WAYLAND_DISPLAY") (error "Wayland session required"))))
    (if (string-prefix? "/" display) display
        (string-append (getenv "XDG_RUNTIME_DIR") "/" display))))
(define runtime (mkdtemp "/tmp/hyprmist-test-XXXXXX"))
(define config (string-append runtime "/test.lua"))
(define children '())
(define instance #f)
(define second-client #f)

(define (spawn . command)
  (let ((pid (primitive-fork)))
    (if (zero? pid)
        (let ((log (open-file (string-append runtime "/children.log") "a")))
          (dup2 (fileno log) 1)
          (dup2 (fileno log) 2)
          (apply execlp (car command) command))
        (begin (set! children (cons pid children)) pid))))

(define (ctl . args)
  (let* ((port (apply open-pipe* OPEN_READ "hyprctl" "-i" instance args))
         (text (get-string-all port))
         (status (close-pipe port)))
    (unless (zero? status) (error "hyprctl failed" args text))
    text))

(define (ok . args)
  (let ((text (apply ctl args)))
    (unless (string=? (string-trim-both text) "ok")
      (error "unexpected compositor response" args text))))

(define (await-ready predicate)
  (let loop ((remaining 200))
    (or (predicate)
        (if (zero? remaining) (error "readiness timeout" runtime)
            (begin (usleep 50000) (loop (- remaining 1)))))))

(define (clients)
  (vector->list (json-string->scm (ctl "clients" "-j"))))
(define (toggle)
  (ok "eval" "hl.dispatch(hl.dsp.workspace.toggle_special('mist-test'))"))

(call-with-output-file config
  (lambda (port)
    (display "hl.monitor({output='', mode='1280x800@60', position='auto', scale=1})
hl.config({misc={disable_hyprland_logo=true,disable_splash_rendering=true},debug={disable_logs=false}})
hl.window_rule({match={class='mist-integration'},workspace='special:mist-test'})
hl.curve('linear',{type='bezier',points={{0,0},{1,1}}})
hl.animation({leaf='specialWorkspace',enabled=true,speed=8,bezier='linear',style='slidefade 15%'})

" port)))

(dynamic-wind
  (lambda ()
    (setenv "XDG_RUNTIME_DIR" runtime)
    (setenv "WAYLAND_DISPLAY" parent-display)
    (setenv "AQ_DRM_DEVICES" "/dev/null")
    (setenv "AQ_NO_KMS_REQUIREMENT" "1")
    (setenv "HYPRLAND_NO_SD_NOTIFY" "1")
    (setenv "HYPRLAND_NO_SD_VARS" "1")
    (unsetenv "HYPRLAND_INSTANCE_SIGNATURE")
    (spawn compositor "--config" config))
  (lambda ()
    (await-ready
     (lambda ()
       (let ((root (string-append runtime "/hypr")))
         (and (file-exists? root)
              (set! instance
                    (find (lambda (name)
                            (file-exists? (string-append root "/" name "/.socket.sock")))
                          (scandir root)))
              instance))))
    (setenv "WAYLAND_DISPLAY" "wayland-1")
    (for-each (lambda (path) (ok "plugin" "load" path)) companions)
    (ok "plugin" "load" mist)
    (ok "eval" "assert(hl.plugin.hyprmist.verify_field(),'GPU reveal endpoints failed')")
    (ok "output" "create" "wayland")
    (spawn "alacritty" "--class" "mist-integration" "-e" "sleep" "300")
    (await-ready (lambda () (= (length (clients)) 1)))
    (ok "eval" "hl.dispatch(hl.dsp.group.toggle())")
    (set! second-client (spawn "alacritty" "--class" "mist-integration" "-e" "sleep" "300"))
    (await-ready (lambda () (= (length (clients)) 2)))
    (unless (every (lambda (client) (= (vector-length (assoc-ref client "grouped")) 2)) (clients))
      (error "test windows did not form a two-tab group"))
    (do ((i 0 (+ i 1))) ((= i 20))
      (toggle)
      (usleep 50000)
      (ok "eval" "assert(hl.plugin.hyprmist.active_effects()>0,'animation emitted no smoke')")
      (when (and (zero? i) (getenv "HYPRMIST_TEST_CAPTURE"))
        (usleep 150000)
        (unless (zero? (system* "grim" "-o" "WAYLAND-1" (getenv "HYPRMIST_TEST_CAPTURE")))
          (error "could not capture test output")))
      (ok "plugin" "unload" mist)
      (ok "plugin" "load" mist)
      (ok "reload")
      (await-ready
       (lambda ()
         (catch #t
           (lambda ()
             (ok "eval" "assert(hl.plugin.hyprmist.tracked_windows()==2,'waiting for window samples')")
             #t)
           (lambda _ #f)))))
    (unless (string-null? (string-trim-both (ctl "configerrors")))
      (error "configuration errors" (ctl "configerrors")))
    (sleep 2)
    (ok "eval" "assert(hl.plugin.hyprmist.active_effects()==0,'particles remain at rest')")
    (when (getenv "HYPRMIST_TEST_CAPTURE")
      (system* "grim" "-o" "WAYLAND-1" (string-append (getenv "HYPRMIST_TEST_CAPTURE") ".idle.png")))
    (kill second-client SIGTERM)
    (await-ready (lambda () (= (length (clients)) 1)))
    (ok "eval" "assert(hl.plugin.hyprmist.closing_windows()>0,'close snapshot was not animated')")
    (when (getenv "HYPRMIST_TEST_CAPTURE")
      (usleep 100000)
      (system* "grim" "-o" "WAYLAND-1" (string-append (getenv "HYPRMIST_TEST_CAPTURE") ".close.png")))
    (ok "eval" "hl.plugin.hyprmist.enable(false)")
    (ok "eval" "assert(hl.plugin.hyprmist.active_effects()==0,'disable did not clear effects')")
    (ok "eval" "hl.plugin.hyprmist.enable(true)")
    (display "PASS: two outputs, groups, animation/reload cycles, close snapshot, disable cleanup\n"))
  (lambda ()
    (for-each (lambda (pid) (false-if-exception (kill pid SIGTERM))) children)
    (for-each (lambda (pid) (false-if-exception (waitpid pid))) children)
    (format #t "Logs retained in ~a\n" runtime)))
